# =====================================================================
# Mountain Route-Finder - Git Ignore Specification
# =====================================================================

# --- Maven Build Artifacts ---
target/
*.class
*.jar
*.war
*.ear

# --- IntelliJ IDEA ---
.idea/
*.iml
*.iws
*.ipr
out/

# --- VS Code & Eclipse ---
.vscode/
.settings/
.project
.classpath

# --- Operating System Noise ---
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# --- SQLite Runtime Database (keep schema.sql + seed-data.sql in VCS) ---
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# --- Application Runtime Generated Exports ---
exports/

# --- Logs & Temporary Files ---
*.log
*.tmp
*.bak

# --- Local Documentation & Rubric Context ---
docs/

